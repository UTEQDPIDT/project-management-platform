{
  "name": "project-management-platform",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "baseline-browser-mapping": "^2.10.40",
    "prettier": "^3.8.4",
    "turbo": "^2.10.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=20.10.0 <21",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.23"
  },
  "pnpm": {
    "overrides": {
      "eslint": "^9.21.0",
      "minimatch": ">=3.1.4",
      "picomatch": ">=4.0.4",
      "form-data": ">=4.0.6",
      "multer": ">=2.2.0",
      "brace-expansion": ">=1.1.13",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "js-yaml": ">=4.2.0"
    }
  }
}