# Environment variables for developing the API server
# Once you've filled in the values, rename this file to .env.development

PORT=3001

FRONTEND_URL=http://localhost:3000

MONGO_HOST=mongodb:27017
MONGO_DB_NAME=uteq_prep_database

# Generate your own Google OAuth credentials in the Google Auth Cloud Console and fill these in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Generate your own JWT secrets and fill these in
JWT_SECRET=
JWT_EXPIRES_IN=8h
COOKIE_SECURE=false

REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRES_IN=7d

# Password used for seeding initial users (choose a strong password for production)
SEED_PASSWORD=

# Password pepper for additional security layer (generate a strong random string)
PASSWORD_PEPPER=
# Email configuration (for sending password reset emails)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your_email@example.com
MAIL_PASSWORD=
MAIL_FROM="PREP UTEQ <your_email@example.com>"
INITIALIZE_PASSWORD_SECRET=

# reCAPTCHA
# Set RECAPTCHA_ENABLED=false only for local development/testing (e.g., Postman)
# Keep RECAPTCHA_ENABLED=true in production and provide RECAPTCHA_SECRET_KEY
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=

# Forgot-password abuse controls
# Cooldown per account between reset email sends (seconds)
FORGOT_PASSWORD_COOLDOWN_SECONDS=60
# Max forgot-password attempts per email inside the configured window
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_MAX_ATTEMPTS=5
# Time window for per-email forgot-password rate limiting (seconds)
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_WINDOW_SECONDS=300
# Password reset token lifetime in minutes
PASSWORD_RESET_TOKEN_TTL_MINUTES=15