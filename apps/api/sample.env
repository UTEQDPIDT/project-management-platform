# Environment variables for developing the API server
# Once you've filled in the values, rename this file to .env.development

PORT=3001

FRONTEND_URL=http://localhost:3000

MONGO_HOST=mongodb:27017
MONGO_DB_NAME=uteq_prep_database

# Generate your own Google OAuth credentials in the Google Auth Cloud Console and fill these in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Generate your own JWT secrets and fill these in
JWT_SECRET=
JWT_EXPIRES_IN=8h

REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRES_IN=7d

# Password used for seeding initial users (choose a strong password for production)
SEED_PASSWORD=